# SQLite por padrão. Para PostgreSQL, configure uma URL SQLAlchemy, por exemplo:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/pl_radar
DATABASE_URL=sqlite+pysqlite:///./data/pl_radar.db
SENADO_BASE_URL=https://legis.senado.leg.br/dadosabertos
SYNC_ON_STARTUP=true
AUTO_CREATE_SCHEMA=true
SYNC_INTERVAL_SECONDS=21600
REQUEST_TIMEOUT_SECONDS=45
CORS_ORIGINS=*
